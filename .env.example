# Demo makes NO external calls and uses canned, clearly labeled responses.
DEMO_MODE=true
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
JENKINS_URL=http://127.0.0.1:8080
JENKINS_USER=assistant-reader
JENKINS_API_TOKEN=
# Required in live mode. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASSISTANT_TOKEN=
# For the iframe when Jenkins is served at another origin; no wildcards.
JENKINS_FRAME_ORIGIN=http://127.0.0.1:8080
# Optional literal secrets to mask in addition to built-in patterns, separated by |
REDACT_VALUES=
# Background server monitoring continues when browsers are closed.
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=15
# Explicit administrator opt-in: send NEW failed builds' redacted logs to Google.
# Enable only for permitted demo jobs after checking log contents and reader scope.
AUTO_ANALYZE_FAILURES=false
